<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RedgifsDownloader.Avalonia.ViewModels"
             x:Class="RedgifsDownloader.Avalonia.Views.DupePicsCleanerView"
             x:DataType="vm:DupePicsCleanerViewModel"
             mc:Ignorable="d"
             x:CompileBindings="True">
  <Grid Margin="8" RowDefinitions="Auto,Auto,*" ColumnDefinitions="Auto,*,Auto">
    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="路径:" />
    <TextBox Grid.Row="0" Grid.Column="1" Margin="8,0,8,0" Text="{Binding TargetFolder}" />
    <Button Grid.Row="0" Grid.Column="2" Content="选择" Click="SelectFolder_OnClick" />

    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0" Orientation="Horizontal" Spacing="8">
      <Button Content="删除所有重复" Command="{Binding DeleteCommand}" />
      <Button Content="重命名" Command="{Binding RenameCommand}" />
    </StackPanel>

    <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" BorderBrush="Gray" BorderThickness="1" Padding="6">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="日志" FontWeight="Bold" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <TextBox x:Name="LogBox"
                   Foreground="Gray"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   Text="{Binding ResultMessage, Mode=OneWay}"
                   TextChanged="LogBox_OnTextChanged" />
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
