<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="using:RedgifsDownloader.Avalonia"
        xmlns:views="using:RedgifsDownloader.Avalonia.Views"
        xmlns:vm="using:RedgifsDownloader.Avalonia.ViewModels"
        x:Class="RedgifsDownloader.Avalonia.MainWindow"
        x:DataType="local:MainWindowViewModel"
        mc:Ignorable="d"
        Width="450"
        Height="550"
        MinWidth="450"
        MinHeight="550"
        Title="Redgifs Downloader v1.0.1">
  <Grid RowDefinitions="Auto,*">
    <Menu Grid.Row="0">
      <MenuItem Header="文件">
        <MenuItem Header="RedGifs" Command="{Binding NavigateCommand}" CommandParameter="Redgifs" />
        <MenuItem Header="Reddit" Command="{Binding NavigateCommand}" CommandParameter="Reddit" />
        <MenuItem Header="ImageSim" Command="{Binding NavigateCommand}" CommandParameter="ImageSim" />
        <MenuItem Header="Dupe Cleaner" Command="{Binding NavigateCommand}" CommandParameter="Cleaner" />
      </MenuItem>
      <MenuItem Header="设置" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
      <MenuItem Header="关于" Command="{Binding NavigateCommand}" CommandParameter="About" />
    </Menu>

    <ContentControl Grid.Row="1" Content="{Binding CurrentView}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:DownloadsViewModel">
          <views:DownloadsView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
          <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="sys:String">
          <TextBlock Text="{Binding}" Margin="16" TextWrapping="Wrap" />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Grid>
</Window>
