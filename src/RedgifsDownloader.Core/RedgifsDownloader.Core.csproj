<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.10" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../ApplicationLayer/**/*.cs" Exclude="../../ApplicationLayer/Notifications/LogService.cs" />
    <Compile Include="../../Domain/**/*.cs" />
    <Compile Include="../../Infrastructure/**/*.cs" Exclude="../../Infrastructure/GlobalExceptionHandler.cs;../../Infrastructure/WpfUiDispatcher.cs;../../Infrastructure/Settings/AppSettings.cs" />
  </ItemGroup>
</Project>
